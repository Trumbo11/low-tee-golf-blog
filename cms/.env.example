# Copy to .env and adjust as needed
PORT=4000
JWT_SECRET=replace-me
# Comma-separated list of allowed origins or hostnames
# Examples:
#   http://localhost:5173,https://my-site.netlify.app
#   http://localhost:4000,localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000
# Optional: wildcard hostname patterns. Supports leading '*.' only.
# Examples:
#   *.netlify.app,*.vercel.app
CORS_ORIGIN_PATTERNS=*.netlify.app
DATABASE_URL="file:./dev.db"
SERVICE_TOKEN=dev-service-token
